# Copiez ce fichier vers .env.local et adaptez vos identifiants MySQL.
# Ne commitez jamais .env.local (voir .gitignore).
#
#   cp .env.local.example .env.local   (Linux/macOS)
#   copy .env.local.example .env.local   (Windows)
#
# Remplacez <YOUR_PASSWORD> par votre mot de passe MySQL local.
# Caractères spéciaux (? ! @ # %) : voir SETUP-MYSQL.md (encodage URL + %% dans .env).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=atelier_rdv_dev_secret_change_me
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# XAMPP / Laragon — root sans mot de passe :
# DATABASE_URL="mysql://root:@127.0.0.1:3306/atelier_rendez_vous?serverVersion=8.0.32&charset=utf8mb4"

# root avec mot de passe :
DATABASE_URL="mysql://root:@127.0.0.1:3306/atelier_rendez_vous?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###
